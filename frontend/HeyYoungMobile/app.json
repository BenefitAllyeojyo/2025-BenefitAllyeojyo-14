{
  "expo": {
    "name": "헤이영, 혜택을 알려줘!",
    "slug": "HeyYoungMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/heyyoungLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/heyyoungLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seogadol.HeyYoungMobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/heyyoungLogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.seogadol.HeyYoungMobile"
    },
    "web": {
      "favicon": "./assets/images/heyyoungLogo.png"
    },
    "notification": {
      "icon": "./assets/images/heyyoungLogo.png",
      "color": "#ffffff",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "새로운 알림",
      "androidChannelId": "default",
      "androidChannelName": "기본 알림",
      "androidChannelDescription": "기본 알림 채널",
      "androidImportance": "high",
      "androidVibratePattern": [0, 250, 250, 250],
      "androidSound": "default",
      "androidColor": "#ffffff"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "43a19c02-a987-4172-8ec9-8af48657eeb0"
      }
    },
    "owner": "seogadol"
  }
}
